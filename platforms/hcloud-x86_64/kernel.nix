# hcloud guests are KVM with virtio-blk/-scsi and virtio-net. The console is
# VNC: VGA text on SeaBIOS (cx), the EFI framebuffer on UEFI (cpx).
{
  enable = [
    "HYPERVISOR_GUEST"
    "PARAVIRT"
    "PARAVIRT_SPINLOCKS"
    "KVM_GUEST"
    "PARAVIRT_CLOCK"
    "X86_X2APIC"
    # arm64 has no compressed Image
    "KERNEL_ZSTD"
    "ACPI"
    "ACPI_BUTTON"
    "DMI"
    "DMIID"
    "DMI_SYSFS"
    "FW_CFG_SYSFS"
    "HPET"
    "HPET_TIMER"
    "RTC_CLASS"
    "RTC_DRV_CMOS"
    "VIRTIO"
    "VIRTIO_MENU"
    "VIRTIO_PCI"
    "VIRTIO_PCI_LEGACY"
    "VIRTIO_MMIO"
    "VIRTIO_BALLOON"
    "VIRTIO_CONSOLE"
    "VIRTIO_BLK"
    "VIRTIO_NET"
    "SCSI"
    "SCSI_LOWLEVEL"
    "SCSI_VIRTIO"
    "BLK_DEV_SD"
    "HW_RANDOM"
    "HW_RANDOM_VIRTIO"
    "NET_9P"
    "NET_9P_VIRTIO"
    "9P_FS"
    "9P_FS_POSIX_ACL"
    "VIRTIO_FS"
    "VT"
    "VT_CONSOLE"
    "VGA_CONSOLE"
    "FB"
    "FB_EFI"
    "FRAMEBUFFER_CONSOLE"
    "INPUT"
    "INPUT_KEYBOARD"
    "KEYBOARD_ATKBD"
    "SERIO"
    "SERIO_I8042"
    "INPUT_EVDEV"
    "SERIAL_8250"
    "SERIAL_8250_CONSOLE"
    # targets/boot-good.nix arms it at boot
    "WATCHDOG"
    "WATCHDOG_SYSFS"
    "SOFT_WATCHDOG"
  ];
  disable = [
    "DRM"
    "DRM_I915"
    "DRM_BOCHS"
    "AGP"
    # efifb binds efi-framebuffer; SYSFB_SIMPLEFB would turn it into
    # simple-framebuffer and leave the UEFI console without a driver
    "SYSFB_SIMPLEFB"
    "FB_VESA"
    "FB_VGA16"
    "MACINTOSH_DRIVERS"
    "ATA"
    "ETHERNET"
    "NET_VENDOR_INTEL"
    "NET_VENDOR_REALTEK"
    "E1000"
    "E1000E"
    "PHYLIB"
    "HWMON"
    "THERMAL"
    "CPU_FREQ"
    "CPU_IDLE_GOV_HALTPOLL"
    "XEN"
    "HYPERV"
    "PERF_EVENTS_INTEL_UNCORE"
    "NUMA"
    "I2C"
    "SPI"
    "GPIOLIB"
    "IOMMU_SUPPORT"
    "AMD_IOMMU"
    "INTEL_IOMMU"
    "X86_MCE_AMD"
    "X86_EXTENDED_PLATFORM"
    "MICROCODE"
    "SUSPEND"
    "PM_SLEEP"
  ];
}
