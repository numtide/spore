# AWS Nitro on Graviton, VM and .metal sizes: UEFI with ACPI, PSCI, GICv3,
# ENA on PCIe, NVMe for EBS and the instance store, a 16550 on the ACPI SPCR
# table as the serial console. The metal sizes have an SMMU; the VM sizes
# expose none. virtio serves only the QEMU boot test.
{
  enable = [
    "ACPI"
    "ACPI_BUTTON"
    "ACPI_SPCR_TABLE"
    # the two-socket .metal-48xl sizes
    "NUMA"
    "ACPI_NUMA"
    # Graviton2 is Neoverse-N1: "(rare)" errata that defconfig leaves out,
    # applied by MIDR at runtime
    "ARM64_ERRATUM_1542419"
    "ARM64_ERRATUM_1286807"
    # a builder wants throughput; defconfig picks full preemption
    "PREEMPT_NONE"
    "SOFTLOCKUP_DETECTOR"
    "DETECT_HUNG_TASK"
    "ARM_PSCI_FW"
    # kexec parks the secondary CPUs through CPU hotplug, which arm64 only
    # offers with PM_SLEEP_SMP
    "SUSPEND"
    "HOTPLUG_CPU"
    "ARM_SMCCC_SOC_ID"
    "PCI_HOST_GENERIC"
    "PCIEPORTBUS"
    "DMI"
    "DMIID"
    "DMI_SYSFS"
    "RTC_CLASS"
    "RTC_DRV_EFI"
    "IOMMU_SUPPORT"
    "IOMMU_DEFAULT_PASSTHROUGH"
    "ARM_SMMU_V3"
    "BLK_DEV_NVME"
    "NVME_CORE"
    "ETHERNET"
    "NET_VENDOR_AMAZON"
    "ENA_ETHERNET"
    "HW_RANDOM"
    "HW_RANDOM_ARM_SMCCC_TRNG"
    "SERIAL_8250"
    "SERIAL_8250_CONSOLE"
    "SERIAL_8250_PCI"
    "SERIAL_8250_DW"
    "SERIAL_AMBA_PL011"
    "SERIAL_AMBA_PL011_CONSOLE"
    "WATCHDOG"
    "WATCHDOG_CORE"
    "SOFT_WATCHDOG"
    "VIRTIO"
    "VIRTIO_MENU"
    "VIRTIO_PCI"
    "VIRTIO_BLK"
    "VIRTIO_NET"
    "HW_RANDOM_VIRTIO"
  ];
  disable = [
    "PREEMPT"
    "DRM"
    "VT"
    "FB"
    "SYSFB_SIMPLEFB"
    # SoC platforms of the arm64 defconfig
    "ARCH_ACTIONS"
    "ARCH_AIROHA"
    "ARCH_SUNXI"
    "ARCH_ALPINE"
    "ARCH_APPLE"
    "ARCH_ARTPEC"
    "ARCH_AXIADO"
    "ARCH_BCM"
    "ARCH_BERLIN"
    "ARCH_BITMAIN"
    "ARCH_BLAIZE"
    "ARCH_CIX"
    "ARCH_EXYNOS"
    "ARCH_SPARX5"
    "ARCH_K3"
    "ARCH_LG1K"
    "ARCH_HISI"
    "ARCH_KEEMBAY"
    "ARCH_MEDIATEK"
    "ARCH_MESON"
    "ARCH_MVEBU"
    "ARCH_NXP"
    "ARCH_MA35"
    "ARCH_NPCM"
    "ARCH_PENSANDO"
    "ARCH_QCOM"
    "ARCH_REALTEK"
    "ARCH_RENESAS"
    "ARCH_ROCKCHIP"
    "ARCH_SEATTLE"
    "ARCH_INTEL_SOCFPGA"
    "ARCH_STM32"
    "ARCH_SOPHGO"
    "ARCH_SYNQUACER"
    "ARCH_TEGRA"
    "ARCH_SPRD"
    "ARCH_THUNDER"
    "ARCH_THUNDER2"
    "ARCH_UNIPHIER"
    "ARCH_VEXPRESS"
    "ARCH_VISCONTI"
    "ARCH_XGENE"
    "ARCH_ZYNQMP"
    "ATA"
    "PHYLIB"
    "HWMON"
    "CPU_FREQ"
    "XEN"
    "HYPERV"
    "I2C"
    "SPI"
    "GPIOLIB"
    "PINCTRL"
    "COMMON_CLK"
    "REMOTEPROC"
    "RPMSG"
    "SOUNDWIRE"
    "MMC"
    "MAILBOX"
    "PHY"
    "NVMEM"
    "INTERCONNECT"
    "ARM_SCMI_PROTOCOL"
    "SCSI"
    "MTD"
    "REGULATOR"
    "THERMAL"
    "PWM"
    "RESET_CONTROLLER"
    "IIO"
    "NET_VENDOR_BROADCOM"
    "NET_VENDOR_CAVIUM"
    "NET_VENDOR_HISILICON"
    "NET_VENDOR_INTEL"
    "NET_VENDOR_MARVELL"
    "NET_VENDOR_MELLANOX"
    "NET_VENDOR_MICROSOFT"
    "NET_VENDOR_QUALCOMM"
    "NET_VENDOR_REALTEK"
    "NET_VENDOR_RENESAS"
    "NET_VENDOR_SMSC"
    "NET_VENDOR_SOCIONEXT"
    "NET_VENDOR_STMICRO"
    "NET_VENDOR_TI"
    "NET_VENDOR_WANGXUN"
  ];
