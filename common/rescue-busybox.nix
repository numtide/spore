# The busybox of the Rust initrd. It serves only the emergency shell: the
# bootstrap execs `setsid cttyhack sh` and nothing else.
{ pkgsStatic, lib }:
let
  applets = [
    "ASH"
    "SH_IS_ASH"
    "CTTYHACK"
    "SETSID"
    "BUSYBOX"
    "AWK"
    "BASENAME"
    "BLKID"
    "CAT"
    "CHMOD"
    "CHROOT"
    "CP"
    "CUT"
    "DATE"
    "DD"
    "DF"
    "DIRNAME"
    "DMESG"
    "DU"
    "ECHO"
    "ENV"
    "FALSE"
    "FDISK"
    "FIND"
    "FINDFS"
    "FREE"
    "GREP"
    "EGREP"
    "HEAD"
    "HEXDUMP"
    "IP"
    "KILL"
    "LESS"
    "LN"
    "LS"
    "MKDIR"
    "MKNOD"
    "MOUNT"
    "MV"
    "NSLOOKUP"
    "PING"
    "POWEROFF"
    "PRINTF"
    "PS"
    "READLINK"
    "REBOOT"
    "RM"
    "SED"
    "SHA256SUM"
    "SLEEP"
    "SORT"
    "STAT"
    "SYNC"
    "TAIL"
    "TEST"
    "TEST1"
    "TEST2"
    "TOUCH"
    "TR"
    "TRUE"
    "UMOUNT"
    "UNAME"
    "VI"
    "WC"
    "WGET"
    "XARGS"
  ];
  features = [
    "ASH_ALIAS"
    "ASH_BASH_COMPAT"
    "ASH_CMDCMD"
    "ASH_ECHO"
    "ASH_GETOPTS"
    "ASH_JOB_CONTROL"
    "ASH_PRINTF"
    "ASH_TEST"
    "FEATURE_SH_MATH"
    "FEATURE_EDITING"
    "FEATURE_EDITING_HISTORY"
    "FEATURE_TAB_COMPLETION"
    "FEATURE_FANCY_ECHO"
    "FEATURE_LS_COLOR"
    "FEATURE_LS_FILETYPES"
    "FEATURE_LS_FOLLOWLINKS"
    "FEATURE_LS_RECURSIVE"
    "FEATURE_LS_SORTFILES"
    "FEATURE_LS_TIMESTAMPS"
    "FEATURE_LS_USERNAME"
    "FEATURE_MOUNT_FLAGS"
    "FEATURE_MOUNT_LABEL"
    "FEATURE_UMOUNT_ALL"
    "FEATURE_IP_ADDRESS"
    "FEATURE_IP_LINK"
    "FEATURE_IP_ROUTE"
    "FEATURE_IP_NEIGH"
    "FEATURE_FANCY_PING"
    "FEATURE_PS_WIDE"
    "FEATURE_BLKID_TYPE"
    "FEATURE_GPT_LABEL"
    "FEATURE_FDISK_WRITABLE"
    "FEATURE_FIND_PRINT0"
    "FEATURE_FIND_MTIME"
    "FEATURE_FIND_TYPE"
    "FEATURE_FIND_NAME"
    "FEATURE_FIND_PATH"
    "FEATURE_FIND_MAXDEPTH"
    "FEATURE_FIND_EXEC"
    "FEATURE_FIND_NOT"
    "FEATURE_FIND_PAREN"
    "FEATURE_FIND_SIZE"
    "FEATURE_XARGS_SUPPORT_ZERO_TERM"
    "FEATURE_TAIL_FANCY"
    "FEATURE_FANCY_HEAD"
    "FEATURE_GREP_CONTEXT"
    "FEATURE_SORT_BIG"
    "FEATURE_STAT_FORMAT"
    "FEATURE_VI_COLON"
    "FEATURE_VI_SEARCH"
    "FEATURE_VI_YANKMARK"
    "FEATURE_VI_DOT_CMD"
    "FEATURE_VI_READONLY"
    "FEATURE_VI_SETOPTS"
    "FEATURE_VI_WIN_RESIZE"
    "FEATURE_LESS_BRACKETS"
    "FEATURE_LESS_FLAGS"
    "FEATURE_WGET_LONG_OPTIONS"
    "FEATURE_WGET_STATUSBAR"
    "FEATURE_WGET_TIMEOUT"
    "FEATURE_DF_FANCY"
    "FEATURE_HUMAN_READABLE"
    "LONG_OPTS"
  ];
in
(pkgsStatic.busybox.override {
  enableMinimal = true;
  extraConfig = lib.concatMapStrings (o: "CONFIG_${o} y\n") (applets ++ features);
}).overrideAttrs
  (o: {
    # allnoconfig leaves the values of the enabled features unset, and
    # oldconfig asks for them
    configurePhase =
      lib.replaceStrings
        [ "make oldconfig" ]
        [
          "(yes '' || true) | make oldconfig"
        ]
        o.configurePhase;
  })
